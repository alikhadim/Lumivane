# Single source of truth for the shipped product identity. Keep APP_NAME in sync with Brand.name in Sources/Lumivane/Design.swift.
# BUNDLE_ID is the production identifier. It must not change after the first public release (it keys the Keychain item, privacy grants and saved settings).
# Reverse-DNS of a domain the publisher controls. lumivane.com was listed for sale when checked: buy it or confirm another domain you own before release.
APP_NAME="Lumivane"
BUNDLE_ID="com.lumivane.app"
# Optional: bundle IDs of earlier test builds the installer should also replace, e.g. PREVIOUS_BUNDLE_IDS="com.example.old" ./scripts/install.sh
PREVIOUS_BUNDLE_IDS="${PREVIOUS_BUNDLE_IDS:-}"
VERSION="1.0.0"
BUILD="3"
# Local code-signing identity (self-signed, created by install.sh). A stable identity keeps macOS privacy grants across rebuilds.
SIGN_NAME="Lumivane Local Signing"
