<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumivane.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AccentColor">#0A84FF</Color>
          <SolidColorBrush x:Key="WinBg" Color="#1E1E1E"/>
          <SolidColorBrush x:Key="SidebarBg" Color="#262429"/>
          <SolidColorBrush x:Key="ToolbarBg" Color="#252525"/>
          <SolidColorBrush x:Key="CardBg" Color="#0AFFFFFF"/>
          <SolidColorBrush x:Key="CardBorder" Color="#12FFFFFF"/>
          <SolidColorBrush x:Key="TileBg" Color="#0DFFFFFF"/>
          <SolidColorBrush x:Key="RowBg" Color="#10FFFFFF"/>
          <SolidColorBrush x:Key="ControlBg" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="ControlBgHover" Color="#48484A"/>
          <SolidColorBrush x:Key="ControlBgPressed" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="FieldBg" Color="#1A1A1C"/>
          <SolidColorBrush x:Key="FieldBorder" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#9E9EA3"/>
          <SolidColorBrush x:Key="TextTertiary" Color="#6E6E73"/>
          <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
          <SolidColorBrush x:Key="SelectionBg" Color="#0A6CFF"/>
          <SolidColorBrush x:Key="TrackBg" Color="#3D3D40"/>
          <SolidColorBrush x:Key="SwitchOff" Color="#5A5A5E"/>
          <SolidColorBrush x:Key="Separator" Color="#26FFFFFF"/>
          <SolidColorBrush x:Key="MenuBg" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="ShadowStrong" Color="#80000000"/>
          <SolidColorBrush x:Key="SegSelected" Color="#636366"/>
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#48484A"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#ECECEC"/>
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="TextControlBackground" Color="#1A1A1C"/>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1A1A1C"/>
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A1A1C"/>
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0A84FF"/>
          <SolidColorBrush x:Key="TextControlForeground" Color="#ECECEC"/>
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6E6E73"/>
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#6E6E73"/>
          <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#9E9EA3"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AccentColor">#007AFF</Color>
          <SolidColorBrush x:Key="WinBg" Color="#F4F4F6"/>
          <SolidColorBrush x:Key="SidebarBg" Color="#E6E4EA"/>
          <SolidColorBrush x:Key="ToolbarBg" Color="#ECECEE"/>
          <SolidColorBrush x:Key="CardBg" Color="#B3FFFFFF"/>
          <SolidColorBrush x:Key="CardBorder" Color="#14000000"/>
          <SolidColorBrush x:Key="TileBg" Color="#0D000000"/>
          <SolidColorBrush x:Key="RowBg" Color="#0F000000"/>
          <SolidColorBrush x:Key="ControlBg" Color="#E3E3E8"/>
          <SolidColorBrush x:Key="ControlBgHover" Color="#D8D8DE"/>
          <SolidColorBrush x:Key="ControlBgPressed" Color="#CBCBD2"/>
          <SolidColorBrush x:Key="FieldBg" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="FieldBorder" Color="#D2D2D7"/>
          <SolidColorBrush x:Key="TextPrimary" Color="#1D1D1F"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73"/>
          <SolidColorBrush x:Key="TextTertiary" Color="#A1A1A6"/>
          <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
          <SolidColorBrush x:Key="SelectionBg" Color="#0A6CFF"/>
          <SolidColorBrush x:Key="TrackBg" Color="#D1D1D6"/>
          <SolidColorBrush x:Key="SwitchOff" Color="#C7C7CC"/>
          <SolidColorBrush x:Key="Separator" Color="#1F000000"/>
          <SolidColorBrush x:Key="MenuBg" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ShadowStrong" Color="#40000000"/>
          <SolidColorBrush x:Key="SegSelected" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#E3E3E8"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#D8D8DE"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#CBCBD2"/>
          <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#E3E3E8"/>
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#1D1D1F"/>
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D2D2D7"/>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#D2D2D7"/>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#007AFF"/>
          <SolidColorBrush x:Key="TextControlForeground" Color="#1D1D1F"/>
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A1A1A6"/>
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#A1A1A6"/>
          <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#6E6E73"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="Green" Color="#30D158"/>
      <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
      <SolidColorBrush x:Key="Red" Color="#FF453A"/>
      <SolidColorBrush x:Key="Yellow" Color="#FFD60A"/>
      <SolidColorBrush x:Key="Pink" Color="#FF2E7A"/>
      <SolidColorBrush x:Key="Blue" Color="#3B7AFF"/>
      <SolidColorBrush x:Key="Warm" Color="#FF7A1A"/>

      <!-- Fluent control resources recolored to the macOS look -->
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent"/>

      <!-- Slider: 4 px track, accent fill, white thumb -->
      <ControlTheme x:Key="MacRepeatFill" TargetType="RepeatButton">
        <Setter Property="Template">
          <ControlTemplate><Border Background="Transparent"/></ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="MacRepeatAccent" TargetType="RepeatButton">
        <Setter Property="Template">
          <ControlTemplate><Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/></ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="MacSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBg}" VerticalAlignment="Center"/>
              <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="Horizontal">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource MacRepeatAccent}" Focusable="False"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource MacRepeatFill}" Focusable="False"/>
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="20" Height="20" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Border Width="20" Height="20" CornerRadius="10" Background="#F6F6F8" BorderBrush="#22000000" BorderThickness="0.5"
                              BoxShadow="0 1 3 0 #55000000"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="MacSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="track" Width="38" Height="22" CornerRadius="11" Background="{DynamicResource SwitchOff}" VerticalAlignment="Center">
              <Border Name="knob" Width="18" Height="18" CornerRadius="9" Background="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0"
                      BoxShadow="0 1 2 0 #55000000">
                <Border.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"/></Transitions></Border.Transitions>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#track"><Setter Property="Background" Value="{DynamicResource Green}"/></Style>
        <Style Selector="^:checked /template/ Border#knob"><Setter Property="RenderTransform" Value="translateX(16px)"/></Style>
      </ControlTheme>

      <ControlTheme x:Key="MacCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
              <Border Name="box" Width="16" Height="16" CornerRadius="4" Background="{DynamicResource ControlBg}" VerticalAlignment="Center" BorderThickness="0.5" BorderBrush="#33FFFFFF">
                <Path Name="tick" Data="M3.4 8.4l3 3 6.2-7" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" IsVisible="False" Stretch="None"/>
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#box"><Setter Property="Background" Value="{DynamicResource SelectionBg}"/></Style>
        <Style Selector="^:checked /template/ Path#tick"><Setter Property="IsVisible" Value="True"/></Style>
      </ControlTheme>

      <ControlTheme x:Key="MacRadio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
              <Border Name="ring" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource ControlBg}" VerticalAlignment="Center" BorderThickness="0.5" BorderBrush="#33FFFFFF">
                <Ellipse Name="dot" Width="6" Height="6" Fill="White" IsVisible="False"/>
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#ring"><Setter Property="Background" Value="{DynamicResource SelectionBg}"/></Style>
        <Style Selector="^:checked /template/ Ellipse#dot"><Setter Property="IsVisible" Value="True"/></Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Cantarell, sans-serif"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource WinBg}"/>
    </Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
    <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></Style>
    <Style Selector="TextBlock.tertiary"><Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.title2"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.title3"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.headline"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.callout"><Setter Property="FontSize" Value="12.5"/></Style>
    <Style Selector="TextBlock.footnote"><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LetterSpacing" Value="0.6"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource TileBg}"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource RowBg}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ControlBgHover}"/></Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ControlBgPressed}"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="Button.prominent"><Setter Property="Background" Value="{DynamicResource SelectionBg}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.prominent:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2B7FFF"/></Style>
    <Style Selector="Button.plain"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="4,2"/></Style>
    <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.plain:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Padding" Value="4,2"/></Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.gradient">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="28,11"/>
      <Setter Property="CornerRadius" Value="30"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
          <GradientStop Color="#FF7A1A" Offset="0"/><GradientStop Color="#FF2E7A" Offset="0.5"/><GradientStop Color="#3B7AFF" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.gradient /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BoxShadow" Value="0 4 14 0 #73FF2E7A"/></Style>
    <Style Selector="Button.gradient.stop /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BoxShadow" Value="0 4 14 0 #73FF453A"/></Style>
    <Style Selector="Button.gradient:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%"><GradientStop Color="#FF8A33" Offset="0"/><GradientStop Color="#FF4488" Offset="0.5"/><GradientStop Color="#5A90FF" Offset="1"/></LinearGradientBrush></Setter></Style>
    <Style Selector="Button.gradient:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%"><GradientStop Color="#E86A10" Offset="0"/><GradientStop Color="#E81E68" Offset="0.5"/><GradientStop Color="#2A68E8" Offset="1"/></LinearGradientBrush></Setter></Style>
    <Style Selector="Button.gradient.stop">
      <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#FF6259" Offset="0"/><GradientStop Color="#FF3B30" Offset="1"/></LinearGradientBrush></Setter>
    </Style>
    <Style Selector="Button.gradient.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#FF7068" Offset="0"/><GradientStop Color="#FF4A40" Offset="1"/></LinearGradientBrush></Setter></Style>

    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="CornerRadius" Value="7"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource TileBg}"/></Style>
    <Style Selector="Button.nav.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBg}"/></Style>
    <Style Selector="Button.seg"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,3"/><Setter Property="CornerRadius" Value="5"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.seg.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SegSelected}"/><Setter Property="BoxShadow" Value="0 1 2 0 #40000000"/></Style>
    <Style Selector="Slider"><Setter Property="Theme" Value="{StaticResource MacSlider}"/></Style>
    <Style Selector="ToggleButton.switch"><Setter Property="Theme" Value="{StaticResource MacSwitch}"/></Style>
    <Style Selector="CheckBox"><Setter Property="Theme" Value="{StaticResource MacCheck}"/></Style>
    <Style Selector="RadioButton"><Setter Property="Theme" Value="{StaticResource MacRadio}"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="24"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="26"/></Style>
    <Style Selector="ScrollViewer"><Setter Property="Background" Value="Transparent"/></Style>
  </Application.Styles>
</Application>
